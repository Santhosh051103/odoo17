        <field name="subject">Legal Notice Project Creation: {{object.name}}</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">rajesh@ekara.global, sandhya@ekara.global, sanjay@ekara.global, harshita@rajendrarao.com</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">

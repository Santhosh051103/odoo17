<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_send_legal_notice_reminder" model="ir.cron">
        <field name="name">Send Notice Reminder</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.send_reminder()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_send_recurrence_reminder" model="ir.cron">
        <field name="name">Recurrence Reminder</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model.send_recurring_reminder()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_create_recurring_task" model="ir.cron">
        <field name="name">Create Recurring Task</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_inverse_state()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="inherit_project_task_view_form" model="ir.ui.view">
        <field name="name">Inherit Project Task Form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='repeat_interval']" position="before">
                <field name="recurring_task" invisible="1"/>
                <field name="recurrence_reminder" invisible="not recurring_task"/>
                <field name="recurrence_reminder2" invisible="not recurring_task"/>
                <field name="task_valid_from" invisible="not recurring_task"/>
                <field name="first_reminder_date" invisible="1"/>
                <field name="second_reminder_date" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="required">recurring_task</attribute>
            </xpath>
        </field>
    </record>

        <record id="cron_check_expired_tasks_recurring" model="ir.cron">
        <field name="name">Recurring Task Expiration Scheduler</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model.check_expired_tasks_recurring()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>

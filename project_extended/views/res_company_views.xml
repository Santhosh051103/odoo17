<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_notice_recipients" model="ir.ui.view">
        <field name="name">res.company.form.notice.recipients</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Notice Recipients">
                    <group>
                        <field name="legal_notice_recipient_ids" widget="many2many_tags"/>
                        <field name="statutory_notice_recipient_ids" widget="many2many_tags"/>
                        <field name="recurring_reminder_recipient_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" ?>
<odoo>
    <data noupdate="0">
        <record id="document_validity_first_reminder_email_template" model="mail.template">
        <field name="name">Document Validity First Reminder: {{object.name}}</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="subject">Document Validity First Reminder: {{object.name}}</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">{{ object.create_uid.email or '' }}</field>
        <field name="body_html">
            <![CDATA[
        <p>Hello,</p>
        <p>This is a reminder that the document validity <b><t t-esc="object.name"/></b> is due for renewal.</p>
        <p>Validity End Date: <t t-esc="object.validity_end_date"/></p>
        <p>Please take the necessary actions.</p>
        ]]>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>

        <record id="document_validity_second_reminder_email_template" model="mail.template">
        <field name="name">Document Validity Second Reminder: {{object.name}}</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="subject">Urgent: Document Validity Second Reminder: {{object.name}}</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">{{ object.create_uid.email or '' }}</field>
        <field name="body_html">
            <![CDATA[
        <p>Hello,</p>
        <p>This is a <strong>final reminder</strong> that the document validity <b><t t-esc="object.name"/></b> is due for renewal very soon.</p>
        <p>Validity End Date: <t t-esc="object.validity_end_date"/></p>
        <p>Please take the necessary actions as soon as possible.</p>
        ]]>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>

        <record id="email_template_status_change" model="mail.template">
            <field name="name">Task Status Change Notification</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="email_from">{{object.project_id.user_id.email_formatted }}</field>
            <field name="email_to">{{object.partner_id.email_formatted }}</field>
            <field name="subject">Attention Required !!</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.partner_id.name or 'Customer'"/>,
                    </p>
                    <p>
                        <strong>
                            <t t-out="object.name"/>
                        </strong>
                         requires your attention.
                    </p>
                    <p>The current status indicates that the
                         <t t-out="object.name"/>
                        <strong>
                            <t t-if="object.stage_id.name == 'To Renew'"> is expired and needs to be renewed.</t>
                            <t t-if="object.stage_id.name == 'Active'"> is active now.</t>
                            <t t-if="object.stage_id.name == 'Expired'"> is Expired now.</t>
                        </strong>

                    </p>

                    <p>Details:</p>
                    <ul>
                        <li>
                            <strong>Name:</strong>
                            <t t-out="object.name"/>
                        </li>
                        <li>
                            <strong>Document Type:</strong>
                            <t t-out="object.document_type_id.name"/>
                        </li>
                        <li>
                            <strong>Start Date:</strong>
                            <t t-out="object.validity_start_date"/>
                        </li>
                        <li>
                            <strong>End Date:</strong>
                            <t t-out="object.validity_end_date"/>
                        </li>
                        <li>
                            <strong>Status:</strong>
                            <t t-out="object.stage_id.name"/>
                        </li>
                    </ul>
                    <p>Best regards,</p>
                    <p>
                        <t t-out="object.project_id.user_id.name"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="email_template_notify_person" model="mail.template">
            <field name="name">Notify Salesperson</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="email_from">{{object.project_id.user_id.email_formatted}}</field>
            <field name="email_to">{{object.project_id.user_id.email_formatted}}</field>
            <field name="subject">Attention Required !!</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.project_id.user_id.name or 'Sales Person'"/>,
                    </p>
                    <p>The current status indicates that the <t t-out="object.name"/>

                        <strong>
                            <t t-if="object.stage_id.name == 'To Renew'"> is expired and needs to be renewed.</t>
                            <t t-if="object.stage_id.name == 'Active'"> is active now.</t>
                            <t t-if="object.stage_id.name == 'Expired'"> is Expired now.</t>

                        </strong>
                    </p>

                    <strong>Task Link:</strong>
                    <a t-att-href="'/web#id=%d&amp;model=project.task' % object.id">View Task</a>

                    <p>Best regards,</p>
                    <p>
                        OdooBot
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

         <record id="documents_share_email_template_custom" model="mail.template">
            <field name="name">Document Share Link</field>
            <field name="model_id" ref="documents.model_documents_share"/>
            <field name="subject">Shared Document Link: {{object.name or 'Document'}}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{','.join([p.email for p in object.partner_ids if p.email])}}</field>
            <field name="body_html" type="html">
                <p>Hello,</p>
                <p>You can download the document here:</p>
                <p>
                    <p>
                        <a t-att-href="object.full_url" class="btn btn-primary">Download Documents</a>
                    </p>
                </p>
                <p>Regards,<br/><t t-out="object.name"/></p>
            </field>
        </record>
    </data>
</odoo>

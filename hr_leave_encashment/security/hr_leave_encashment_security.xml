<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_encashment_rule_own" model="ir.rule">
        <field name="name">Leave Encashment: employee sees own requests</field>
        <field name="model_id" ref="model_hr_leave_encashment"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="hr_leave_encashment_rule_officer" model="ir.rule">
        <field name="name">Leave Encashment: HR Officer sees all requests</field>
        <field name="model_id" ref="model_hr_leave_encashment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

</odoo>

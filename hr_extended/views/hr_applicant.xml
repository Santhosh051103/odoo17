        <record id="hr_recruitment_stage_form_inherit" model="ir.ui.view">
            <field name="name">hr.recruitment.stage.form.inherit</field>
            <field name="model">hr.recruitment.stage</field>
            <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
            <field name="arch" type="xml">
                <field name='job_ids' position='after'>
                    <field name='stage'/>
                </field>
            </field>
        </record>

        <record id="view_salary_breakup_line_form" model="ir.ui.view">
    <field name="name">salary.breakup.lines.form</field>
    <field name="model">salary.breakup.lines</field>
    <field name="arch" type="xml">
        <form string="Salary Breakup Details">

            <sheet>
                <group>
                    <field name="applicant_id" readonly="1"/>
                    <field name="salary_breakup_type" readonly="1"/>
                    <field name="state" readonly="1"/>
                    <field name="salary_proposed" readonly="state in ('approved','rejected')"/>
                </group>

               <notebook position="inside">
                    <page string="Salary Breakup">
                        <button name="calculate_salary" invisible="state in ('approved','rejected')" type="object" string="Calculate Salary" class="btn-primary"/>
                        <group readonly="state in ('approved','rejected')">
                            <group string="Compensation Details">
                                <field name="monthly_fixed_salary"/>
                                <label for="statutory_bonus_applicable"/>
                                <div class="o_row">
                                    <field name="statutory_bonus_applicable"/>
                                </div>
                                <label for="provident_fund_applicable"/>
                                <div class="o_row">
                                    <field name="provident_fund_applicable"/>
                                </div>
                                <label for="esi_applicable"/>
                                <div class="o_row">
                                    <field name="esi_applicable"/>
                                </div>
                                <label for="variable_pay_percentage"/>
                                <div class="o_row">
                                    <field name="variable_pay_percentage"/>
                                </div>
                            </group>
                            <group string="Compensation Details">
                                <field name="grade"/>
                                <field name="locations_id"  options="{'no_quick_create':True,'no_create': True,}"/>
                                <field name="medical_insurance"/>
                                <field name="group_personal_accident_insurance"/>
                                <field name="health_benefit_plan"/>
                                <field name="indicative_take_home_salary" readonly="1" force_save="1"/>
                            </group>
                            <group string="Salary Break-up (Per Annum)">
                                <field name="basic_da_per_annum" readonly="1" force_save="1"/>
                                <field name="hra_per_annum" readonly="1" force_save="1"/>
                                <field name="special_allowance_per_annum" readonly="1" force_save="1"/>
                                <field name="sub_total_a_per_annum" readonly="1" force_save="1" invisible="1"/>

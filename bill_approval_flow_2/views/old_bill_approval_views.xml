<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         BILL APPROVAL — FORM VIEW
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_bill_approval_form" model="ir.ui.view">
        <field name="name">bill.approval.form</field>
        <field name="model">bill.approval</field>
        <field name="arch" type="xml">
            <form string="Bill Approval">
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="btn-primary"
                            invisible="approver_status != 'draft'"/>

                    <button name="action_approve_l1" string="Approve (L1)"
                            type="object" class="btn-success"
                            invisible="not can_approve_l1"/>

                    <button name="action_approve_l2" string="Approve (L2)"
                            type="object" class="btn-success"
                            invisible="not can_approve_l2"/>

                    <button name="action_approve_l3" string="Approve (L3 – Final)"
                            type="object" class="btn-success"
                            invisible="not can_approve_l3"/>

                    <button name="action_open_bill"
                            type="object"
                            string="Bill"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="action_open_debit_notes"
                            type="object"
                            string="Debit Note"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="action_open_invoice"
                            type="object"
                            string="Invoice"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="action_open_credit_notes"
                            type="object"
                            string="Credit Note"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="action_open_credit_card_payment"
                            type="object"
                            string="Credit Card Payment"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="action_open_credit_expense"
                            type="object"
                            string="Credit Card Expenses"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>

                    <button name="action_open_journal"
                            type="object"
                            string="Journal"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="action_open_payment"
                            type="object"
                            string="Payment"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="action_open_receipt"
                            type="object"
                            string="Receipts"
                            class="btn-primary" invisible="approver_status != 'approved'"
                            groups="bill_approval_flow_2.group_create_entry"/>
                    <button name="move_to_history" type="object" string="Move to History" invisible="approver_status != 'approved' or is_history"
                            groups="bill_approval_flow_2.group_create_entry" class="btn-secondary"/>

                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="not can_reject"/>

                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="approver_status != 'rejected'"/>

                    <field name="approver_status" widget="statusbar"
                           statusbar_visible="draft,waiting_l1,waiting_l2,waiting_l3,approved,done"/>

                    <field name="can_approve_l1" invisible="1"/>
                    <field name="can_approve_l2" invisible="1"/>
                    <field name="can_approve_l3" invisible="1"/>
                    <field name="can_reject" invisible="1"/>
                    <field name="can_create_bill" invisible="1"/>
                    <field name="can_create_payment" invisible="1"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bills" type="object"
                                class="oe_stat_button" icon="fa-file-text-o" string="Bills and Invoices"
                                invisible="approver_status not in ['approved','done']">

                        </button>
                        <button name="action_view_payment" type="object"
                                class="oe_stat_button" icon="fa-credit-card" string="Payments"
                                invisible="approver_status not in ['approved','done']">
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ── Supplier & Classification ── -->
                    <group>
                        <group string="Supplier Details">
                            <field name="supplier_name" readonly="approver_status != 'draft'" required="1" options="{'no_quick_create':True,'no_create': True,}"/>
                            <field name="email" readonly="1"/>
                            <field name="timestamp" readonly="approver_status != 'draft'"/>
                        </group>
                        <group string="Classification">
                            <field name="capex_opex" readonly="approver_status != 'draft'"/>
                            <field name="expense_head_capex"
                                   invisible="capex_opex != 'capex'" readonly="approver_status != 'draft'" required="capex_opex == 'capex'"/>

                            <field name="expense_head_opex"
                                   invisible="capex_opex != 'opex'" readonly="approver_status != 'draft'" required="capex_opex != 'capex'"/>
                            <field name="document_type" readonly="approver_status != 'draft'" required="1"/>
                        </group>
                    </group>

                    <!-- ── Invoice ── -->
                    <group string="Invoice Details">
                        <group>
                            <field name="invoice_no" readonly="approver_status != 'draft'" required="1"/>
                            <field name="invoice_date" readonly="approver_status != 'draft'" required="1"/>
                            <field name="move_status" string="Bill Status"/>
                            <field name="account_move_ids" invisible="1"/>
                            <field name="payment_ids" invisible="1"/>
                            <field name="payment_status_display"/>
                            <field name="company_id" readonly="1"/>
                            <field name="payment_status_refresh" invisible="1"/>
                            <field name="is_history" invisible="1"/>
                            <field name="is_history_dup" invisible="1"/>
                        </group>
                        <group>
                            <field name="taxable_value" readonly="approver_status != 'draft'" required="1"/>
                            <field name="gst" readonly="approver_status != 'draft'"/>
                            <field name="total_value" readonly="1"/>
                        </group>
                    </group>

                    <!-- ── Notes ── -->
                    <group string="Notes">
                        <group>
                            <field name="description"
                                   placeholder="Description..." readonly="approver_status != 'draft'" required="1"/>
                            <!--                        <field name="attachment_link" widget="url"/>-->
                            <!--                        <field name="reviewer_comment"/>-->
                        </group>
                    </group>

                    <!-- ── 3-Level Approval Panel ── -->
                    <separator string="Approval Levels" invisible="1"/>
                    <group invisible="1">
                        <group string="Level 1 — Department Head">
                            <field name="l1_status" widget="badge"
                                   decoration-success="l1_status == 'approved'"
                                   decoration-warning="l1_status == 'pending'"
                                   decoration-danger="l1_status == 'rejected'"/>
                            <field name="l1_user_id" readonly="1"
                                   invisible="not l1_user_id"/>
                            <field name="l1_date" readonly="1"
                                   invisible="not l1_date"/>
                            <field name="l1_comment" readonly="1"
                                   invisible="not l1_comment"/>
                        </group>
                        <group string="Level 2 — Finance Manager">
                            <field name="l2_status" widget="badge"
                                   decoration-success="l2_status == 'approved'"
                                   decoration-warning="l2_status == 'pending'"
                                   decoration-danger="l2_status == 'rejected'"/>
                            <field name="l2_user_id" readonly="1"
                                   invisible="not l2_user_id"/>
                            <field name="l2_date" readonly="1"
                                   invisible="not l2_date"/>
                            <field name="l2_comment" readonly="1"
                                   invisible="not l2_comment"/>
                        </group>
                    </group>
                    <group invisible="1">
                        <group string="Level 3 — Director / CFO">
                            <field name="l3_status" widget="badge"
                                   decoration-success="l3_status == 'approved'"
                                   decoration-warning="l3_status == 'pending'"
                                   decoration-danger="l3_status == 'rejected'"/>
                            <field name="l3_user_id" readonly="1"
                                   invisible="not l3_user_id"/>
                            <field name="l3_date" readonly="1"
                                   invisible="not l3_date"/>
                            <field name="l3_comment" readonly="1"
                                   invisible="not l3_comment"/>
                        </group>
                    </group>

                    <!-- ── History ── -->
                    <separator string="History"/>
                    <field name="step_log_ids" readonly="1" nolabel="1">
                        <tree decoration-success="action in ('approved','bill_created','payment_created')"
                              decoration-danger="action == 'rejected'">
                            <field name="date"/>
                            <field name="step_name"/>
                            <field name="action"/>
                            <field name="user_id"/>
                            <!--                            <field name="account_move_id" optional="show"/>-->
                            <!--                            <field name="payment_id" optional="show"/>-->
                            <field name="note" optional="show"/>
                        </tree>
                    </field>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── List ── -->
    <record id="view_bill_approval_list" model="ir.ui.view">
        <field name="name">bill.approval.list</field>
        <field name="model">bill.approval</field>
        <field name="arch" type="xml">
            <tree string="Bill Approvals"
                  decoration-muted="approver_status == 'done'"
                  decoration-danger="approver_status == 'rejected'"
                  decoration-success="approver_status in ('approved','done')"
                  decoration-warning="approver_status in ('waiting_l1','waiting_l2','waiting_l3')">
                <field name="name" optional="hide"/>
                <field name="timestamp" optional="hide"/>
                <field name="email" optional="hide"/>
                <field name="supplier_name" optional="hide"/>
                <field name="description" optional="hide"/>
                <field name="capex_opex" optional="hide"/>
                <field name="expense_head" optional="hide"/>
                <field name="document_type" string="Doc Type" optional="hide"/>
                <field name="invoice_no" string="Doc No" optional="hide"/>
                <field name="invoice_date" string="Doc Date" optional="hide"/>
                <field name="taxable_value" optional="hide"/>
                <field name="gst" optional="hide"/>
                <field name="total_value" optional="hide"/>
                <field name="approver_status" widget="badge"
                       decoration-success="approver_status in ('approved','done')"
                       decoration-warning="approver_status in ('waiting_l1','waiting_l2','waiting_l3')"
                       decoration-danger="approver_status == 'rejected'" optional="hide"/>
                <field name="move_status" optional="hide"/>
                <field name="payment_status_display" optional="hide"/>
                <field name="payment_status_refresh" column_invisible="1"/>
                <field name="company_id" optional="hide"/>
                <field name="can_approve_l1" column_invisible="1"/>
                    <field name="can_approve_l2" column_invisible="1"/>
                    <field name="can_approve_l3" column_invisible="1"/>
                    <field name="can_reject" column_invisible="1"/>
                <field name="l1_status" widget="badge"
                       decoration-success="l1_status == 'approved'"
                       decoration-warning="l1_status == 'pending'"
                       decoration-danger="l1_status == 'rejected'"
                       optional="show"/>
                <field name="l2_status" widget="badge"
                       decoration-success="l2_status == 'approved'"
                       decoration-warning="l2_status == 'pending'"
                       decoration-danger="l2_status == 'rejected'"
                       optional="show"/>
                <field name="l3_status" widget="badge"
                       decoration-success="l3_status == 'approved'"
                       decoration-warning="l3_status == 'pending'"
                       decoration-danger="l3_status == 'rejected'"
                       optional="show"/>
                <button name="action_approve_l1" string="Approve (L1)"
                            type="object" class="btn-success"
                            invisible="not can_approve_l1"/>

                    <button name="action_approve_l2" string="Approve (L2)"
                            type="object" class="btn-success"
                            invisible="not can_approve_l2"/>

                    <button name="action_approve_l3" string="Approve (L3 – Final)"
                            type="object" class="btn-success"
                            invisible="not can_approve_l3"/>
                <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="not can_reject"/>

            </tree>
        </field>
    </record>

    <!-- ── Search ── -->
    <record id="view_bill_approval_search" model="ir.ui.view">
        <field name="name">bill.approval.search</field>
        <field name="model">bill.approval</field>
        <field name="arch" type="xml">
            <search>
                <field name="supplier_name"/>
                <field name="invoice_no"/>
                <filter string="Draft" name="draft" domain="[('approver_status','=','draft')]"/>
                <filter string="Waiting L1" name="wl1" domain="[('approver_status','=','waiting_l1')]"/>
                <filter string="Waiting L2" name="wl2" domain="[('approver_status','=','waiting_l2')]"/>
                <filter string="Waiting L3" name="wl3" domain="[('approver_status','=','waiting_l3')]"/>
                <filter string="Approved" name="app" domain="[('approver_status','=','approved')]"/>
                <filter string="Done" name="done" domain="[('approver_status','=','done')]"/>
                <filter string="Rejected" name="rej" domain="[('approver_status','=','rejected')]"/>
                <field name="company_id"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="g_status" context="{'group_by':'approver_status'}"/>
                    <filter string="Capex/Opex" name="g_capex" context="{'group_by':'capex_opex'}"/>
                    <filter string="Supplier" name="g_supplier" context="{'group_by':'supplier_name'}"/>
                    <filter string="Company" name="company_id" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_approval_pivot" model="ir.ui.view">
        <field name="name">approval.pivot</field>
        <field name="model">bill.approval</field>
        <field name="arch" type="xml">
            <pivot string="Bill Approvals">
                <field name="approver_status" type="col"/>
                <field name="document_type" type="row"/>
                <field name="move_status" type="row"/>
                <field name="payment_status_display" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- ── Action ── -->
    <record id="action_bill_approval" model="ir.actions.act_window">
        <field name="name">Bill Approvals</field>
        <field name="res_model">bill.approval</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('approver_status', 'not in', ['approved','done']),('company_id', 'in', allowed_company_ids)]</field>
        <field name="search_view_id" ref="view_bill_approval_search"/>
    </record>
    <record id="action_bill_approved" model="ir.actions.act_window">
        <field name="name">Bills Approved</field>
        <field name="res_model">bill.approval</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': 0}</field>
        <field name="domain">
            [('approver_status', '=', 'approved'),('company_id', 'in', allowed_company_ids),
            ('is_history', '=', False)]
        </field>
    </record>
    <record id="action_bill_history" model="ir.actions.act_window">
        <field name="name">Bills History</field>
        <field name="res_model">bill.approval</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': 0}</field>
        <field name="domain">
            [('is_history', '=', True),('company_id', 'in', allowed_company_ids)]
        </field>
    </record>
    <record id="action_approval_report" model="ir.actions.act_window">
        <field name="name">Approval Report</field>
        <field name="res_model">bill.approval</field>
        <field name="view_mode">pivot</field>
        <field name="domain">
            [('company_id', 'in', allowed_company_ids)]
        </field>
    </record>
    <record id="view_bill_approval_document_list" model="ir.ui.view">
        <field name="name">bill.approval.document.list</field>
        <field name="model">bill.approval.document</field>
        <field name="arch" type="xml">
            <tree string="Approval Document" editable="top">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_bill_approval_document" model="ir.actions.act_window">
        <field name="name">Approval Document</field>
        <field name="res_model">bill.approval.document</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>

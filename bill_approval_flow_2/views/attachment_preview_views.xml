<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Custom kanban used by bill.approval.action_view_attachments().

            Odoo's stock ir.attachment kanban only links through to the
            plain attachment form (raw binary field), so clicking
            a PDF downloads it rather than showing it. This view instead
            embeds each attachment inline via an iframe pointing at
            /web/content/ID, so the browser's own native PDF/image
            viewer renders it directly inside the popup: no download,
            no navigating away from the list.
        -->
        <record id="bill_approval_attachment_preview_kanban" model="ir.ui.view">
            <field name="name">bill.approval.attachment.preview.kanban</field>
            <field name="model">ir.attachment</field>
            <field name="arch" type="xml">
                <kanban create="false" class="o_kanban_dashboard">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="mimetype"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click" style="width:100%;">
                                <div class="o_kanban_record_top mb8">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div t-if="record.mimetype.raw_value == 'application/pdf'">
                                    <iframe
                                        t-attf-src="/web/content/#{record.id.raw_value}#view=FitH"
                                        style="width:100%; height:70vh; border:1px solid #dee2e6;"
                                        frameborder="0"/>
                                </div>
                                <div t-elif="record.mimetype.raw_value and record.mimetype.raw_value.startsWith('image/')">
                                    <img t-attf-src="/web/content/#{record.id.raw_value}"
                                         style="max-width:100%; height:auto; border:1px solid #dee2e6;"
                                         alt="Attachment preview"/>
                                </div>
                                <div t-else="" class="text-muted">
                                    <p>
                                        No inline preview available for this file type
                                        (<field name="mimetype"/>).
                                    </p>
                                    <a t-attf-href="/web/content/#{record.id.raw_value}?download=true"
                                       class="btn btn-sm btn-primary" target="_blank">
                                        Download
                                    </a>
                                </div>
                                <div class="mt8">
                                    <a t-attf-href="/web/content/#{record.id.raw_value}"
                                       class="btn btn-sm btn-secondary" target="_blank">
                                        Open in new tab
                                    </a>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>
